# ---------------------------------------------------------------------------
# Pramaan backend configuration.
# Copy to .env and fill values. NEVER commit a real .env file.
# All settings are read by app/config.py (pydantic-settings).
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development              # development | testing | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api
APP_NAME=Pramaan API
TIMEZONE=Asia/Kolkata

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*

# Database
# Local development/tests may use SQLite:
DATABASE_URL=sqlite:///./pramaan.db
# Production (Supabase connection pooler is recommended):
# DATABASE_URL=postgresql+psycopg://postgres.<project>:<password>@<host>:6543/postgres?sslmode=require
AUTO_CREATE_TABLES=true              # true for local/dev; run scripts.migrate in production
PGVECTOR_ENABLED=false               # true when the pgvector extension/column is provisioned

# Admin bootstrap (used by scripts/create_admin.py and optional startup seeding)
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Pramaan Admin

# Optional demo data seeding (scripts/seed_demo.py reads this)
SEED_DEMO_DATA=false

# PDF storage
STORAGE_BACKEND=local                # local | supabase
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
PUBLIC_FILE_ACCESS=true              # students may download published notice PDFs

# Supabase (required when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pramaan-documents
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# Google Gemini
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# Retrieval
EMBEDDING_DIM=768
STATIC_SIMILARITY_THRESHOLD=0.15
MAX_STATIC_CONTEXT_CHUNKS=6
MIN_EXTRACTION_CONFIDENCE=0.45

# Rate limiting (per process, in-memory; use a shared store for multi-instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
